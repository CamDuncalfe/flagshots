{
  "name": "flagshots",
  "version": "0.1.0",
  "description": "Screenshots your app in each Flagsmith flag variant and posts them side by side on the pull request",
  "license": "MIT",
  "author": "Cam Duncalfe",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "flagsmith:up": "docker compose up -d",
    "flagsmith:down": "docker compose down",
    "seed": "node scripts/seed.js",
    "demo": "npm --prefix demo run dev",
    "demo:build": "npm --prefix demo run build",
    "demo:preview": "npm --prefix demo run preview",
    "shots": "node src/cli.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "playwright": "1.65.1"
  },
  "bin": {
    "flagshots": "src/cli.js"
  }
}
